@model Attendify.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var institution = User.FindFirst("InstitutionName")?.Value ?? "";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1">Welcome, @Model.FirstName!</h2>
    <div class="text-muted">@institution</div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="stat-card"><div class="stat-value">@Model.LiveNow</div><div class="stat-label">Live sessions</div></div>
    </div>
    <div class="col-md-4">
        <div class="stat-card"><div class="stat-value">@Model.Students</div><div class="stat-label">Students</div></div>
    </div>
    <div class="col-md-4">
        <div class="stat-card"><div class="stat-value">@Model.Lecturers</div><div class="stat-label">Lecturers</div></div>
    </div>
</div>
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card"><div class="stat-value">@Model.Modules</div><div class="stat-label">Modules</div></div>
    </div>
    <div class="col-md-4">
        <div class="stat-card"><div class="stat-value">@Model.Venues</div><div class="stat-label">Venues</div></div>
    </div>
    <div class="col-md-4">
        <div class="stat-card"><div class="stat-value">@Model.WeeklySlots</div><div class="stat-label">Weekly timetable slots</div></div>
    </div>
</div>

<div class="card shadow-sm border-0" style="border-radius:16px;">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h5 class="mb-1">Timetable</h5>
            <div class="text-muted">@Model.ClassesToday classes scheduled today. Add a weekly slot once and Attendify creates every dated class for you.</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Admin" asp-action="Sessions" class="btn btn-outline-primary">View timetable</a>
            <a asp-controller="Admin" asp-action="CreateSlot" class="btn btn-primary">Add weekly slot</a>
        </div>
    </div>
</div>