@model Attendify.Models.AddUserViewModel
@{
    ViewData["Title"] = "Add user";
}

<h2 class="fw-bold mb-4">Add user</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0" style="border-radius:16px; max-width:760px;">
    <div class="card-body p-4">
        <form asp-action="AddUser" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Role" class="form-label">Role</label>
                    <select asp-for="Role" class="form-select">
                        <option value="Student">Student</option>
                        <option value="Lecturer">Lecturer</option>
                    </select>
                    <span asp-validation-for="Role" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Reference" class="form-label" id="refLabel">Student number</label>
                    <input asp-for="Reference" class="form-control" />
                    <span asp-validation-for="Reference" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="FirstName" class="form-label">First name</label>
                    <input asp-for="FirstName" class="form-control" />
                    <span asp-validation-for="FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="LastName" class="form-label">Last name</label>
                    <input asp-for="LastName" class="form-control" />
                    <span asp-validation-for="LastName" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label">Phone number</label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Username" class="form-label">Username (used to log in)</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label">Initial password</label>
                    <input asp-for="Password" class="form-control" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="col-md-6" id="studentOnly">
                    <label asp-for="Qualification" class="form-label">Qualification</label>
                    <input asp-for="Qualification" class="form-control" />
                </div>
                <div class="col-md-6" id="lecturerOnly" style="display:none;">
                    <label asp-for="Department" class="form-label">Department</label>
                    <input asp-for="Department" class="form-control" />
                </div>
            </div>

            <div class="mt-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary px-4">Add user</button>
                <a asp-action="Users" class="btn btn-outline-primary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function syncRole() {
            var isStudent = document.getElementById('Role').value === 'Student';
            document.getElementById('studentOnly').style.display = isStudent ? '' : 'none';
            document.getElementById('lecturerOnly').style.display = isStudent ? 'none' : '';
            document.getElementById('refLabel').textContent = isStudent ? 'Student number' : 'Staff number';
        }
        document.getElementById('Role').addEventListener('change', syncRole);
        syncRole();
    </script>
}