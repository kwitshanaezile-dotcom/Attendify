@model List<Attendify.Models.AdminVenueRow>
@{ ViewData["Title"] = "Venues"; }

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0">Venues</h2>
    <a asp-action="VenueForm" class="btn btn-primary">+ Add venue</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }

<div class="card shadow-sm border-0" style="border-radius:16px;">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Venue</th><th>Latitude</th><th>Longitude</th><th>Allowed radius</th><th>Classes</th><th></th></tr>
            </thead>
            <tbody>
                @foreach (var v in Model)
                {
                    <tr>
                        <td><strong>@v.VenueName</strong></td>
                        <td>@v.Latitude.ToString("0.000000")</td>
                        <td>@v.Longitude.ToString("0.000000")</td>
                        <td>@v.AllowedRadius.ToString("0.##") m</td>
                        <td>@v.Classes</td>
                        <td class="text-end">
                            <a asp-action="VenueForm" asp-route-id="@v.VenueId" class="btn btn-sm btn-outline-primary">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No venues yet.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>