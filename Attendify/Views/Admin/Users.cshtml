@model Attendify.Models.AdminUsersViewModel
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h2 class="fw-bold mb-0">Users</h2>
    <a asp-action="AddUser" class="btn btn-primary">+ Add user</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<form method="get" class="mb-3 d-flex gap-2 flex-wrap">
    <input type="text" name="q" value="@Model.Query" class="form-control" style="max-width:320px;"
           placeholder="Search name, username or number" />
    <button type="submit" class="btn btn-outline-primary">Search</button>
    @if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <a asp-action="Users" class="btn btn-link">Clear</a>
    }
</form>

@foreach (var g in Model.Rows.GroupBy(r => r.Role))
{
    var detailHeader = g.Key == "Student" ? "Qualification" : g.Key == "Lecturer" ? "Department" : "Office";
    <h5 class="fw-bold mt-4 mb-2">@g.Key<text>s</text> <span class="text-muted fs-6">(@g.Count())</span></h5>
    <div class="card shadow-sm border-0" style="border-radius:16px;">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr><th>Name</th><th>Username</th><th>Email</th><th>Number</th><th>@detailHeader</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var r in g)
                    {
                        <tr>
                            <td><strong>@r.FullName</strong></td>
                            <td>@r.Username</td>
                            <td>@r.Email</td>
                            <td>@r.Reference</td>
                            <td>@r.Detail</td>
                            <td class="text-end">
                                <a asp-action="EditUser" asp-route-id="@r.PersonId" class="btn btn-sm btn-outline-primary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (!Model.Rows.Any())
{
    <div class="alert alert-secondary">No users found.</div>
}