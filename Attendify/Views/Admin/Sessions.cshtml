@model List<Attendify.Models.AdminSlotItem>
@{
    ViewData["Title"] = "Sessions";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0">Sessions</h2>
    <a asp-action="CreateSlot" class="btn btn-primary">+ Add weekly slot</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-warning">@TempData["Error"]</div>
}

<div class="card shadow-sm border-0" style="border-radius:16px;">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr>
                    <th>Day</th>
                    <th>Start</th>
                    <th>End</th>
                    <th>Module</th>
                    <th>Lecturer</th>
                    <th>Venue</th>
                    <th>Runs</th>
                    <th>Classes</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td><strong>@s.Day</strong></td>
                        <td>@s.StartTime.ToString(@"hh\:mm")</td>
                        <td>@s.EndTime.ToString(@"hh\:mm")</td>
                        <td>@s.ModuleCode <span class="text-muted small d-none d-xl-inline">· @s.ModuleName</span></td>
                        <td>@s.LecturerName</td>
                        <td>@s.VenueName</td>
                        <td class="small">@s.FromDate.ToString("dd MMM yyyy") – @s.ToDate.ToString("dd MMM yyyy")</td>
                        <td class="small">@s.UpcomingClasses upcoming / @s.TotalClasses total</td>
                        <td class="text-end">
                            @if (s.UpcomingClasses > 0)
                            {
                                <form asp-action="RemoveSlot" method="post"
                                      onsubmit="return confirm('Remove all upcoming classes in this slot? Past classes and classes with attendance are kept.');">
                                    <input type="hidden" name="moduleId" value="@s.ModuleId" />
                                    <input type="hidden" name="venueId" value="@s.VenueId" />
                                    <input type="hidden" name="day" value="@s.Day" />
                                    <input type="hidden" name="startTime" value="@s.StartTime.ToString("c")" />
                                    <input type="hidden" name="endTime" value="@s.EndTime.ToString("c")" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No timetable slots yet. Click "Add weekly slot" to create one.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>