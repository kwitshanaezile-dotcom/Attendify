@model List<Attendify.Models.AdminModuleRow>
@{ ViewData["Title"] = "Modules"; }

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="fw-bold mb-0">Modules</h2>
    <a asp-action="AddModule" class="btn btn-primary">+ Add module</a>
</div>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-warning">@TempData["Error"]</div> }

@foreach (var m in Model)
{
    <div class="card shadow-sm mb-3" style="border-radius:16px;">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="text-primary fw-bold">@m.ModuleCode</div>
                <h5 class="mb-1">@m.ModuleName</h5>
                <div class="text-muted small">
                    👩‍🏫 @m.LecturerName &nbsp;·&nbsp;
                    👥 @m.Students @(m.Students == 1 ? "student" : "students") &nbsp;·&nbsp;
                    🗓️ @m.Classes @(m.Classes == 1 ? "class" : "classes")
                </div>
            </div>
            <a asp-action="EnrollStudents" asp-route-id="@m.ModuleId" class="btn btn-sm btn-outline-primary">Manage students</a>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">No modules yet.</div>
}