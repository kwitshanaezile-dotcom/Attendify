@model List<Attendify.Models.LecturerModuleItem>
@{
    ViewData["Title"] = "My Modules";
}

<h2 class="fw-bold mb-4">My modules</h2>

@foreach (var m in Model)
{
    <div class="card shadow-sm mb-3" style="border-radius:16px;">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="text-primary fw-bold">@m.ModuleCode</div>
                <h5 class="mb-1">@m.ModuleName</h5>
                <div class="text-muted small">
                    👥 @m.StudentCount @(m.StudentCount == 1 ? "student" : "students")
                    &nbsp;·&nbsp;
                    🗓️ @m.SessionCount @(m.SessionCount == 1 ? "class" : "classes")
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Attendances" asp-route-moduleId="@m.ModuleId"
                   class="btn btn-sm btn-outline-primary">Attendance</a>
                <a asp-action="Reports" class="btn btn-sm btn-outline-primary">Report</a>
            </div>
        </div>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-secondary">You have no modules assigned yet.</div>
}